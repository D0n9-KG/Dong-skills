{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/.codex/hooks/launch-project-ops.mjs\"",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -EncodedCommand ",
            "timeout": 30,
            "statusMessage": "Loading project ops state"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|apply_patch|Read|Grep|Glob|Search|Find|Open|codegraph|web|browser|shell_command|exec_command|Bash|Shell|PowerShell|powershell|cmd",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/.codex/hooks/launch-project-ops.mjs\"",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -EncodedCommand ",
            "timeout": 30,
            "statusMessage": "Checking artifact index freshness"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/.codex/hooks/launch-project-ops.mjs\"",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -EncodedCommand ",
            "timeout": 10,
            "statusMessage": "Scanning for learning cues"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/.codex/hooks/launch-project-ops.mjs\"",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -EncodedCommand ",
            "timeout": 30,
            "statusMessage": "Checking handoff before compaction"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/.codex/hooks/launch-project-ops.mjs\"",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -EncodedCommand ",
            "timeout": 30,
            "statusMessage": "Recovering project ops state"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/.codex/hooks/launch-project-ops.mjs\"",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -EncodedCommand ",
            "timeout": 30,
            "statusMessage": "Checking project ops state before stop"
          }
        ]
      }
    ]
  }
}
