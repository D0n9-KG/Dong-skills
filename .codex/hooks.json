{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"let d='';process.stdin.on('data',c=>d+=c).on('end',()=>{let i=JSON.parse(d),x=require('node:child_process'),p=require('node:path'),g=x.spawnSync('git',['-C',i.cwd||'.','rev-parse','--show-toplevel'],{encoding:'utf8'});if(g.status!==0){process.stdout.write('{}');return;}let q=x.spawnSync(process.execPath,[p.join((g.stdout||'').trim(),'.codex/hooks/launch-project-ops.mjs')],{input:d,encoding:'utf8'});process.stdout.write(q.stdout||'');process.stderr.write(q.stderr||'');process.exit(q.status??1)})\"",
            "timeout": 10,
            "statusMessage": "Loading project context"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|apply_patch|Bash|Shell|PowerShell|powershell|cmd|shell_command|exec_command|mcp__.*|ext__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"let d='';process.stdin.on('data',c=>d+=c).on('end',()=>{let i=JSON.parse(d),x=require('node:child_process'),p=require('node:path'),g=x.spawnSync('git',['-C',i.cwd||'.','rev-parse','--show-toplevel'],{encoding:'utf8'});if(g.status!==0){process.stdout.write('{}');return;}let q=x.spawnSync(process.execPath,[p.join((g.stdout||'').trim(),'.codex/hooks/launch-project-ops.mjs')],{input:d,encoding:'utf8'});process.stdout.write(q.stdout||'');process.stderr.write(q.stderr||'');process.exit(q.status??1)})\"",
            "timeout": 15,
            "statusMessage": "Checking explicit project writes"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"let d='';process.stdin.on('data',c=>d+=c).on('end',()=>{let i=JSON.parse(d),x=require('node:child_process'),p=require('node:path'),g=x.spawnSync('git',['-C',i.cwd||'.','rev-parse','--show-toplevel'],{encoding:'utf8'});if(g.status!==0){process.stdout.write('{}');return;}let q=x.spawnSync(process.execPath,[p.join((g.stdout||'').trim(),'.codex/hooks/launch-project-ops.mjs')],{input:d,encoding:'utf8'});process.stdout.write(q.stdout||'');process.stderr.write(q.stderr||'');process.exit(q.status??1)})\"",
            "timeout": 10,
            "statusMessage": "Saving compact recovery snapshot"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"let d='';process.stdin.on('data',c=>d+=c).on('end',()=>{let i=JSON.parse(d),x=require('node:child_process'),p=require('node:path'),g=x.spawnSync('git',['-C',i.cwd||'.','rev-parse','--show-toplevel'],{encoding:'utf8'});if(g.status!==0){process.stdout.write('{}');return;}let q=x.spawnSync(process.execPath,[p.join((g.stdout||'').trim(),'.codex/hooks/launch-project-ops.mjs')],{input:d,encoding:'utf8'});process.stdout.write(q.stdout||'');process.stderr.write(q.stderr||'');process.exit(q.status??1)})\"",
            "timeout": 10,
            "statusMessage": "Checking project advisory"
          }
        ]
      }
    ]
  }
}
